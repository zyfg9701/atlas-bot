# RL1 optional probe helpers — NO real secrets.
# Copy to a private path (e.g. ~/.config/atlas-bot/probe-box-llm-live.env) — do NOT commit filled values.
# Usage: set vars below, then run: ./scripts/probe-box-llm-live.sh
# Does NOT call a real LLM chat/completions, does NOT print API keys, does NOT replace human two-turn handtest.
# NOT wired into CI gates.

# --- Gateway bypass (product default remains cli) ---
ATLAS_GATEWAY_BACKEND=box
ATLAS_BOX_WORKSPACE=./data/box-workspace

# --- Real OpenAI-compat (yellow-tag only; CI must stay on mock stub) ---
ATLAS_BOX_LLM_BASE_URL=                 # e.g. http://127.0.0.1:11434/v1  or  https://<private-gateway>/v1
ATLAS_BOX_LLM_MODEL=                    # e.g. llama3.2 — must already be pulled / deployed
# ATLAS_BOX_LLM_API_KEY=                # leave unset in committed examples; local/private only
# ATLAS_BOX_LLM_MODE=                   # must NOT be mock|off for real-model yellow-tag
ATLAS_BOX_LLM_TIMEOUT_MS=60000
ATLAS_BOX_HISTORY_MAX_TURNS=32

# Optional healthz target for the probe (default http://127.0.0.1:8787/healthz)
# ATLAS_BOX_LLM_HEALTHZ_URL=http://127.0.0.1:8787/healthz

# After yellow-tag: unset ATLAS_BOX_LLM_* (or MODE=mock) and set ATLAS_GATEWAY_BACKEND=cli (or unset).
# Never put a real BASE_URL into CI Actions.
