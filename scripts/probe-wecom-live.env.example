# WL1 optional probe helpers — NO real secrets.
# Copy to a private path (e.g. ~/.config/atlas-bot/probe-wecom-live.env) — do NOT commit filled values.
# Usage: set vars below, then run: ./scripts/probe-wecom-live.sh
# Does NOT call qyapi, does NOT exchange codes, does NOT replace human authorize.
# NOT wired into CI gates.

# --- Client / shared (safe to echo hostnames) ---
ATLAS_TICKET_PROVIDER=wecom
ATLAS_WECOM_CORP_ID=                      # real corpId when yellow-tagging (do not commit)
ATLAS_WECOM_AGENT_ID=                     # real agentId when yellow-tagging (do not commit)
ATLAS_WECOM_AUTHORIZE_BASE=               # live authorize host, e.g. https://open.weixin.qq.com/...
ATLAS_WECOM_REDIRECT_URI=http://127.0.0.1:8765/callback
ATLAS_OIDC_REDIRECT_PORT=8765
ATLAS_HUB_HTTP=http://127.0.0.1:7700
# Mobile deep link (register on WeCom console; not an env for all surfaces):
#   atlasbot://auth/callback

# --- Hub only (never put SECRET values in git / PR / evidence) ---
# ATLAS_WECOM_SECRET=                     # Hub-only; leave unset in committed examples
ATLAS_WECOM_API_BASE=                     # live: https://qyapi.weixin.qq.com — CI must stay on mock
ATLAS_AUTH_MODE=static
# ATLAS_AUTH_JWT_SECRET=                  # Hub-only; leave unset in committed examples

# --- Live handtest: do NOT set ATLAS_I2_NO_BROWSER ---
# ATLAS_I2_NO_BROWSER=1                   # mock/CI only

# After yellow-tag: switch AUTHORIZE_BASE + API_BASE back to mock-wecom printed base.
